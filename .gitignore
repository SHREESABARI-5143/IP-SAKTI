.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Databases
*.sqlite
*.sqlite3
*.db
*.db-journal
ayura.db
backend/ayura.db
ipsakti.db
backend/ipsakti.db

