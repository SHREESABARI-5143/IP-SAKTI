# ════════════════════════════════════════════════════════
# AYURA (IP-SAKTI Sahayak) - Root Git Ignore
# ════════════════════════════════════════════════════════

# ── Environment & Secrets (NEVER COMMIT SENSITIVE DATA) ──
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# ── Python & Backend ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

