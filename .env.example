# =====================================================
# IP-SAKTI SAHAYAK — ENVIRONMENT CONFIGURATION
# =====================================================

# Security & Tokens
SECRET_KEY=ipsakti-production-secret-key-replace-in-real-deployment-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for zero-config; Postgres with pgvector in production)
DATABASE_URL=sqlite+aiosqlite:///./ipsakti.db
SYNC_DATABASE_URL=sqlite:///./ipsakti.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ipsakti_db
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ipsakti_db

# LLM Providers (Google Gemini default, OpenAI, Anthropic, or Local)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Redis (Optional background task queue & caching)
REDIS_URL=redis://localhost:6379/0

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
