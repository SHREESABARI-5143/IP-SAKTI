# ==============================================================================
# IP-SAKTI SAHAYAK — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to '.env' in the project root to configure local/production settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="IP-SAKTI Sahayak"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 2. DATABASE & VECTOR STORAGE
# ------------------------------------------------------------------------------
# Local Development Mode (Default zero-dependency SQLite - NO credentials needed):
DATABASE_URL="sqlite+aiosqlite:///./ipsakti.db"
SYNC_DATABASE_URL="sqlite:///./ipsakti.db"
VECTOR_BACKEND="sqlite"

# Production Mode (PostgreSQL 16 + pgvector extension):
# POSTGRES_URL="postgresql+asyncpg://ipsakti_admin:your_secure_password@localhost:5432/ipsakti_prod"
# DATABASE_URL="postgresql+asyncpg://ipsakti_admin:your_secure_password@localhost:5432/ipsakti_prod"
# SYNC_DATABASE_URL="postgresql://ipsakti_admin:your_secure_password@localhost:5432/ipsakti_prod"
# VECTOR_BACKEND="pgvector"

# ------------------------------------------------------------------------------
# 3. LLM PROVIDER CONFIGURATION (Local Open-Source & Offline Zero-API)
# ------------------------------------------------------------------------------
# Provider options:
# - "ollama"        : Local Open-Source Ollama model (llama3.1:latest) — NO API key required.
# - "deterministic" : Zero-dependency, offline deterministic legal synthesizer — NO API key / NO LLM required.
# - "vllm"          : Local high-throughput OpenAI-compatible endpoint (e.g. vLLM / SGLang).
LLM_PROVIDER="ollama"

# Local Ollama Configuration:
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:latest"
OLLAMA_TIMEOUT_SECONDS=60.0
DEFAULT_MODEL="llama3.1:latest"

# Local Embedding Model (Runs locally via HuggingFace / BM25 - NO API key needed):
EMBEDDING_MODEL="BAAI/bge-m3"

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
