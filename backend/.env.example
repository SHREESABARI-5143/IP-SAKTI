# ════════════════════════════════════════════════════════
# IP-SAKTI Sahayak Backend Configuration
# ════════════════════════════════════════════════════════

# LLM Provider: 'ollama' (Local Qwen 2.5:3b) or 'gemini'
LLM_PROVIDER=ollama

# Local Ollama Configuration (Local Qwen 2.5:3b Instruct)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Google Gemini API Key (Optional / Cloud Fallback)
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# SQLite Database URL
DATABASE_URL=sqlite+aiosqlite:///./ipsakti.db
