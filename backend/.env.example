# ════════════════════════════════════════════════════════
# IP-SAKTI Sahayak Backend Configuration (100% Local)
# ════════════════════════════════════════════════════════

# 100% Local Offline LLM Provider
LLM_PROVIDER=ollama

# Local Ollama Configuration (Local Qwen 2.5:3b Instruct)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
VECTOR_DIMENSION=768

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# PostgreSQL + pgvector Database URL (Consolidated Single DB)
DATABASE_URL=postgresql+asyncpg://ipsakti:ipsakti_secure_2026@localhost:5432/ipsakti


